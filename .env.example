# Runtime
APP_ENV=local
LOG_LEVEL=INFO

# World Bank API
WB_API_BASE_URL=https://api.worldbank.org/v2
WB_API_TIMEOUT_SECONDS=30
WB_API_PER_PAGE=1000
WB_API_MAX_ATTEMPTS=3
WB_API_RETRY_WAIT_SECONDS=0.5

# Local storage
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# Project configuration
RESEARCH_CONFIG_PATH=configs/research.yaml
INDICATORS_CONFIG_PATH=configs/indicators.yaml
COUNTRY_GROUPS_CONFIG_PATH=configs/country_groups.yaml

# Reserved for later milestones: ClickHouse
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=wb_insight
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# Reserved for later milestones: Yandex Object Storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Reserved for later milestones: Yandex Cloud AI Studio
YANDEX_FOLDER_ID=
YANDEX_MODEL_URI=
