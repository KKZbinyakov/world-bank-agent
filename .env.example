# Runtime
APP_ENV=local
LOG_LEVEL=INFO

# World Bank API
WB_API_BASE_URL=https://api.worldbank.org/v2
WB_API_TIMEOUT_SECONDS=30
WB_API_PER_PAGE=1000
WB_API_MAX_ATTEMPTS=3
WB_API_RETRY_WAIT_SECONDS=0.5

# Local storage
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# Project configuration
RESEARCH_CONFIG_PATH=configs/research.yaml
INDICATORS_CONFIG_PATH=configs/indicators.yaml
COUNTRY_GROUPS_CONFIG_PATH=configs/country_groups.yaml

# ClickHouse. These defaults match docker-compose.yml for local development.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=wb_insight
CLICKHOUSE_USER=wb_insight
CLICKHOUSE_PASSWORD=wb_insight_local
CLICKHOUSE_SECURE=false

# Reserved for later milestones: Yandex Object Storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Reserved for later milestones: Yandex Cloud AI Studio
YANDEX_FOLDER_ID=
YANDEX_MODEL_URI=

# Read-only Tool API
API_HOST=0.0.0.0
API_PORT=8000
API_DOCS_ENABLED=true
MARTS_CONFIG_PATH=configs/marts.yaml
